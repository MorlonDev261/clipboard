# Influencor web — copier en .env (jamais versionné).
# influencor.mi-kandra.org sert désormais le site vitrine (dépôt influencor-web) :
# l'app web Flutter n'est déployée que si un AUTRE domaine est indiqué ici.
INFLUENCOR_DOMAIN=
# Certificat d'origine (Cloudflare « Origin Certificate » ou Let's Encrypt),
# à placer dans nginx/certs/ ; SSL Cloudflare en mode Full (strict).
SSL_CERT_PATH=/etc/nginx/certs/fullchain.pem
SSL_KEY_PATH=/etc/nginx/certs/privkey.pem
