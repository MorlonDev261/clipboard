# =============================================================================
# Vhost Influencor (build web Flutter) — nginx d'origine Mi Kandra.
#
# Syntaxe envsubst :
#   ${VAR}  → variable Docker injectée au démarrage (ex: ${INFLUENCOR_DOMAIN})
#   $$var   → variable Nginx runtime (rendue $var après envsubst)
# =============================================================================

# IP client réelle : derrière le routeur partagé (:8443, PROXY protocol) et/ou
# derrière le proxy Cloudflare (nuage orange).
include /etc/nginx/snippets/mi-kandra-realip.conf;
include /etc/nginx/snippets/mi-kandra-cloudflare.conf;

# Host inconnu / scan direct de l'IP : on coupe, sans rien révéler.
server {
    listen 80 default_server;
    include /etc/nginx/snippets/mi-kandra-listen-http-default.conf;
    server_name _;

    # Healthcheck Docker (local au conteneur).
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok
";
    }
    location / { return 444; }
}

server {
    listen 443 ssl default_server;
    include /etc/nginx/snippets/mi-kandra-listen-tls-default.conf;
    server_name _;
    ssl_reject_handshake on;
}

# HTTP → HTTPS (Cloudflare en « Full (strict) » ne reboucle pas ici).
server {
    listen 80;
    include /etc/nginx/snippets/mi-kandra-listen-http.conf;
    server_name ${INFLUENCOR_DOMAIN};
    return 301 https://$$host$$request_uri;
}

server {
    listen 443 ssl;
    include /etc/nginx/snippets/mi-kandra-listen-tls.conf;
    http2 on;
    server_name ${INFLUENCOR_DOMAIN};

    ssl_certificate     ${SSL_CERT_PATH};
    ssl_certificate_key ${SSL_KEY_PATH};
    include /etc/nginx/snippets/ssl-params.conf;

    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/wasm;
    gzip_min_length 1024;

    # Fichiers non versionnés par hash : toujours revalidés, sinon une nouvelle
    # version du build resterait coincée dans le cache / le service worker.
    location ~* ^/(index\.html|flutter_bootstrap\.js|flutter_service_worker\.js|version\.json|manifest\.json)$$ {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $$uri =404;
    }

    location ~* \.(?:js|wasm|css|png|jpg|jpeg|svg|ico|ttf|otf|woff2?|json|bin)$$ {
        add_header Cache-Control "public, max-age=86400" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $$uri =404;
    }

    # Routes de l'app (go_router) : retombent sur index.html.
    location / {
        add_header Cache-Control "no-cache" always;
        try_files $$uri $$uri/ /index.html;
    }
}
